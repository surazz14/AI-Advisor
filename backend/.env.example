# CORS origins allowed to connect (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bind host/port for uvicorn (optional; CLI flags override)
HOST=0.0.0.0
PORT=8000

# Supabase (same project used by policy_rag upload)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Written answers from retrieved clauses
# auto = first available of: Groq → Hugging Face → Gemini
LLM_PROVIDER=auto

# Recommended free option (fast): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Hugging Face Inference Providers: https://huggingface.co/settings/tokens
# (enable "Make calls to Inference Providers")
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Simple 2-hop RAG (retrieve → follow-up search → merge → answer)
MULTI_HOP=true
MULTI_HOP_MATCH_COUNT=10
MULTI_HOP_FINAL_COUNT=12
