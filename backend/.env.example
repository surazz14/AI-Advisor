# CORS origins allowed to connect (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bind host/port for uvicorn (optional; CLI flags override)
HOST=0.0.0.0
PORT=8000

# Supabase (same project used by policy_rag upload)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Google Gemini (written answers from retrieved clauses)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
