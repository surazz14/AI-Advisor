# Used by docker compose (copy to .env on the server)
WEB_PORT=3000
API_PORT=8000

# Browser-reachable WebSocket URL (baked into the Next.js image at build time)
NEXT_PUBLIC_WS_URL=ws://15.135.78.79:8000/ws/chat

# Allowed browser origins for the FastAPI CORS middleware
CORS_ORIGINS=http://15.135.78.79:3000

# Nominatim identification
NOMINATIM_USER_AGENT=PlantagenetPlanningAdvisor/0.1 (docker)

# --- Required for policy RAG answers ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# LLM (pick one)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional alternatives
GROQ_API_KEY=
HF_TOKEN=

MULTI_HOP=true
HYBRID_SEARCH=true
