# Used by docker compose — copy to BOTH:
#   .env            (project root, used by compose + api env_file)
#   backend/.env    (also loaded by the api container as fallback)
WEB_PORT=3000
API_PORT=8000

# Browser-reachable WebSocket URL (baked into the Next.js image at build time)
NEXT_PUBLIC_WS_URL=ws://15.135.78.79:8000/ws/chat

# Allowed browser origins for the FastAPI CORS middleware
CORS_ORIGINS=http://15.135.78.79:3000

# Nominatim identification
NOMINATIM_USER_AGENT=PlantagenetPlanningAdvisor/0.1 (docker)

# --- Required for policy RAG answers (must be non-empty on the server) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# LLM (pick one) — Groq's free tier is the default
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional alternatives
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
HF_TOKEN=

MULTI_HOP=true
HYBRID_SEARCH=true
