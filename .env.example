# Optional: identify your app to OpenStreetMap Nominatim
# https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=PlantagenetPlanningAdvisor/0.1 (your-email@example.com)

# FastAPI chat WebSocket endpoint
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat

# FastAPI base URL used by the Next.js server for exact address search
# (optional — defaults to the host of NEXT_PUBLIC_WS_URL)
ADVISOR_API_URL=http://localhost:8000
